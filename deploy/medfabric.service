[Unit]
Description=MedFabric data platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fuwuqi
Group=fuwuqi
WorkingDirectory=/mnt/medfabric
Environment=MEDFABRIC_ENV=demo
Environment=MEDFABRIC_DATA_DIR=/mnt/medfabric/work/demo-data
Environment=MEDFABRIC_CONTROL_DIR=/mnt/medfabric/runtime
Environment=MEDFABRIC_LLM_PROVIDER=openai_compatible
Environment=MEDFABRIC_OPENAI_BASE_URL=http://114.212.173.201:8080/v1
Environment=MEDFABRIC_OPENAI_MODEL=qwen3.8-flash-next-iq3_s
Environment=MEDFABRIC_OPENAI_TIMEOUT=300
EnvironmentFile=/home/fuwuqi/.config/medfabric/api.env
ExecStart=/home/fuwuqi/.conda/envs/medfabric/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8321
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
